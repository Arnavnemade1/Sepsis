# Python virtual environment
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Environment secrets
backend/.env

# Local SQLite database
backend/sepsis_twin.db

# Clinical dataset cache (PhysioNet/CinC 2019 — redistribute via PhysioNet only)
data/cinc2019/
data/models/
data/bidmc/
# Trained model artifacts + logs (large, regenerable)
artifacts/feature_cache/
# Raw out-of-fold prediction vectors: regenerable, and large. The result JSONs
# beside them are committed, so the frontier tables stay reproducible from the repo.
artifacts/frontier/*_oof.npz
artifacts/*.joblib
artifacts/*.log
# …except the production model, which must ship so the deployed backend can load it
!artifacts/gbm_wearable.joblib
# Promotion backups of the previous detector: git history already holds it.
artifacts/*.joblib.*.bak
# Proof-signing keystore — the Ed25519 PRIVATE key must NEVER be committed.
# (Only the public key travels, inside each exported certificate bundle.)
artifacts/keystore/

# ── Node / Next.js (site/) ──────────────────────────────────────────────
# The marketing site in site/ is the only Node project in this repo. There is
# deliberately NO package.json at the repo root: Cloudflare Pages builds webui/
# with an empty build command, and a root manifest would make its build system
# start guessing at a framework.
node_modules/
.next/
out/
.vercel/
.turbo/
*.tsbuildinfo
next-env.d.ts
.env*.local
# Hero footage masters are hundreds of MB; the ENCODED outputs in
# site/public/media/ are committed and must not be ignored.
site/media-src/
site/public/media/*.mov
# NOTE: the unanchored `dist/` and `build/` patterns above also apply inside
# site/. Harmless today (Next builds to .next/ and out/), but if a tool is ever
# pointed at site/build its output will silently vanish from commits.

# macOS
.DS_Store

# IDE
.idea/
.vscode/

# Bundled CC-BY real-patient sample IS committed (small, attributed)
!data/cohort_sample/
data/ddinter/
