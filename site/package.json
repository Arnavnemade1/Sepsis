{
  "name": "aegis-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "sync:results": "node scripts/sync-results.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "video:studio": "remotion studio remotion/index.ts",
    "video:render": "remotion render remotion/index.ts explainer public/media/explainer.mp4 --codec=h264 --crf=18",
    "video:still": "remotion still remotion/index.ts explainer public/media/explainer-poster.png --frame=90"
  },
  "dependencies": {
    "motion": "13.1.0",
    "next": "16.3.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.512",
    "@remotion/player": "4.0.512"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.512",
    "@remotion/cli": "4.0.512",
    "@remotion/renderer": "4.0.512",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.15.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
