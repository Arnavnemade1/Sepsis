{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "aegis",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "backend.aegis.server:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8140"
      ],
      "port": 8140
    },
    {
      "name": "site",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "site",
        "run",
        "dev",
        "--",
        "--port",
        "3070"
      ],
      "port": 3070
    },
    {
      "name": "site-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "site",
        "run",
        "start",
        "--",
        "--port",
        "3071"
      ],
      "port": 3071
    }
  ]
}
